# Frontend-safe values only. Copy this file to .env for local development.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
VITE_APP_ENV=development

# Never add server secrets below as VITE_ variables.
# Configure these with Supabase Edge Function secrets instead:
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# APP_ENV=development
# RESTAURANT_ID=YOUR_RESTAURANT_UUID
# PUBLIC_APP_URL=https://YOUR_VERCEL_DOMAIN
